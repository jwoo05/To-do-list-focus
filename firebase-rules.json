{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "profiles": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".read": "auth != null"
      }
    },
    "codes": {
      "$code": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)",
        ".read": "auth != null"
      }
    },
    "friendReq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "friendAccept": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "groups": {
      "$gid": {
        ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : newData.child('owner').val() === auth.uid)",
        "members": {
          "$member": {
            ".write": "auth != null && auth.uid === $member"
          }
        },
        ".read": "auth != null"
      }
    },
    "groupCodes": {
      "$code": {
        ".write": "auth != null && !data.exists()",
        ".read": "auth != null"
      }
    },
    "photos": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "shared": {
      "$sid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid",
        "name": {
          ".write": "auth != null && data.parent().child('owner').val() === auth.uid"
        },
        "members": {
          "$m": {
            ".write": "auth != null && (auth.uid === $m || data.parent().parent().child('owner').val() === auth.uid)"
          }
        },
        "items": {
          "$i": {
            ".write": "auth != null && data.parent().parent().child('members').child(auth.uid).exists()"
          }
        }
      }
    },
    "cheers": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        ".write": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)",
          ".validate": "!newData.exists() || (newData.child('e').isString() && newData.child('e').val().length <= 8 && newData.child('n').isString() && newData.child('n').val().length <= 60 && newData.child('at').isNumber())"
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && $name.matches(/^[a-z0-9_.]{3,20}$/)"
      }
    }
  }
}
