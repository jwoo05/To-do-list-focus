{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "codes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)"
      }
    },
    "friendReq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "friendAccept": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "groups": {
      ".read": "auth != null",
      "$gid": {
        ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : newData.child('owner').val() === auth.uid)",
        "members": {
          "$member": {
            ".write": "auth != null && auth.uid === $member"
          }
        }
      }
    },
    "groupCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && !data.exists()"
      }
    },
    "photos": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}