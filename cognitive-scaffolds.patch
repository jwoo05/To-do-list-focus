+        <span class="domain-name">${esc(n)}</span>
+        <span class="domain-count">${c}</span>
+        <button class="domain-mode" onclick="setDomainMode('${esc(n)}','${active?'ktlo':'active'}')" title="Toggle mode">${active?'Active':'KTLO'}</button>
+      </div>`;
+    }).join('')}</div>`;
+}
